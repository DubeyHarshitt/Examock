generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String              @id @default(uuid())
  gmailId          String              @unique @map("gmail_id")
  email            String              @unique
  name             String?
  avatarUrl        String?             @map("avatar_url")
  mobile           String?             @unique
  mobileVerified   Boolean             @default(false) @map("mobile_verified")
  examTypeId       String?             @map("exam_type_id")
  examDate         DateTime?           @map("exam_date") @db.Date
  role             Role                @default(STUDENT)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  refreshTokenHash String?             @map("refresh_token_hash")
  doubtSessions    DoubtSession[]
  uploadedNotes    Note[]              @relation("NoteUploader")
  otpRecords       OtpRecord[]
  payments         Payment[]
  testAttempts     TestAttempt[]
  topicProgress    UserTopicProgress[]
  examType         ExamType?           @relation(fields: [examTypeId], references: [id])

  @@map("users")
}

model OtpRecord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  mobile    String
  otp       String
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mobile])
  @@map("otp_records")
}

model ExamType {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  mockTests   MockTest[]
  notes       Note[]
  subjects    Subject[]
  users       User[]
  ytChannels  YtChannel[]

  @@map("exam_types")
}

model Subject {
  id         String     @id @default(uuid())
  examTypeId String     @map("exam_type_id")
  name       String
  orderIndex Int        @default(0) @map("order_index")
  createdAt  DateTime   @default(now()) @map("created_at")
  mockTests  MockTest[]
  notes      Note[]
  examType   ExamType   @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  topics     Topic[]

  @@index([examTypeId])
  @@map("subjects")
}

model Topic {
  id           String              @id @default(uuid())
  subjectId    String              @map("subject_id")
  name         String
  orderIndex   Int                 @default(0) @map("order_index")
  createdAt    DateTime            @default(now()) @map("created_at")
  chapterTests MockTest[]          @relation("ChapterTestTopic")
  notes        Note[]
  questions    Question[]
  subject      Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userProgress UserTopicProgress[]
  videos       Video[]

  @@index([subjectId])
  @@map("topics")
}

model Video {
  id          String   @id @default(uuid())
  topicId     String   @map("topic_id")
  youtubeId   String   @map("youtube_id")
  title       String
  durationSec Int?     @map("duration_sec")
  orderIndex  Int      @default(0) @map("order_index")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("videos")
}

model YtChannel {
  id          String   @id @default(uuid())
  examTypeId  String   @map("exam_type_id")
  channelId   String   @map("channel_id")
  channelName String   @map("channel_name")
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  examType    ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@index([examTypeId])
  @@map("yt_channels")
}

model MockTest {
  id           String         @id @default(uuid())
  examTypeId   String         @map("exam_type_id")
  title        String
  type         TestType
  isFree       Boolean        @default(false) @map("is_free")
  durationMins Int            @map("duration_mins")
  totalMarks   Int            @map("total_marks")
  topicId      String?        @map("topic_id")
  subjectId    String?        @map("subject_id")
  instructions String?
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  examType     ExamType       @relation(fields: [examTypeId], references: [id])
  subject      Subject?       @relation(fields: [subjectId], references: [id])
  topic        Topic?         @relation("ChapterTestTopic", fields: [topicId], references: [id])
  payments     Payment[]
  attempts     TestAttempt[]
  questions    TestQuestion[]

  @@index([examTypeId])
  @@index([type, isFree])
  @@map("mock_tests")
}

model Question {
  id            String         @id @default(uuid())
  topicId       String         @map("topic_id")
  text          String
  optionA       String         @map("option_a")
  optionB       String         @map("option_b")
  optionC       String         @map("option_c")
  optionD       String         @map("option_d")
  correctOption String         @map("correct_option")
  explanation   String?
  marks         Int            @default(1)
  negMarks      Float          @default(0) @map("neg_marks")
  difficulty    Difficulty     @default(MEDIUM)
  createdAt     DateTime       @default(now()) @map("created_at")
  topic         Topic          @relation(fields: [topicId], references: [id])
  testQuestions TestQuestion[]

  @@index([topicId])
  @@map("questions")
}

model TestQuestion {
  testId     String   @map("test_id")
  questionId String   @map("question_id")
  orderIndex Int      @default(0) @map("order_index")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  test       MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@map("test_questions")
}

model TestAttempt {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  mockTestId   String        @map("mock_test_id")
  status       AttemptStatus @default(IN_PROGRESS)
  score        Float?
  percentile   Float?
  timeTakenSec Int?          @map("time_taken_sec")
  answersJson  Json?         @map("answers_json")
  startedAt    DateTime      @default(now()) @map("started_at")
  completedAt  DateTime?     @map("completed_at")
  mockTest     MockTest      @relation(fields: [mockTestId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mockTestId])
  @@index([userId, mockTestId])
  @@map("test_attempts")
}

model UserTopicProgress {
  userId        String   @map("user_id")
  topicId       String   @map("topic_id")
  videosWatched Int      @default(0) @map("videos_watched")
  bestScore     Float?   @map("best_score")
  attemptCount  Int      @default(0) @map("attempt_count")
  lastActivity  DateTime @default(now()) @map("last_activity")
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([userId])
  @@map("user_topic_progress")
}

model Payment {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  mockTestId        String        @map("mock_test_id")
  razorpayOrderId   String        @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  razorpaySignature String?       @map("razorpay_signature")
  amountPaise       Int           @map("amount_paise")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  mockTest          MockTest      @relation(fields: [mockTestId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([mockTestId])
  @@map("payments")
}

model DoubtSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  topicId   String?  @map("topic_id")
  messages  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("doubt_sessions")
}

model Notification {
  id         String    @id @default(uuid())
  examTypeId String?   @map("exam_type_id")
  title      String
  body       String
  sentAt     DateTime? @map("sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([examTypeId])
  @@map("notifications")
}

model Note {
  id         String   @id @default(uuid())
  topicId    String?  @map("topic_id")
  subjectId  String?  @map("subject_id")
  examTypeId String   @map("exam_type_id")
  title      String
  fileUrl    String   @map("file_url")
  fileType   FileType @map("file_type")
  fileSizeMb Float?   @map("file_size_mb")
  isFree     Boolean  @default(false) @map("is_free")
  isActive   Boolean  @default(true) @map("is_active")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  examType   ExamType @relation(fields: [examTypeId], references: [id])
  subject    Subject? @relation(fields: [subjectId], references: [id])
  topic      Topic?   @relation(fields: [topicId], references: [id])
  uploader   User     @relation("NoteUploader", fields: [uploadedBy], references: [id])

  @@index([topicId])
  @@index([subjectId])
  @@index([examTypeId])
  @@map("notes")
}

enum FileType {
  PDF
  EXCEL
  DOCX
  PPT
  IMAGE
  OTHER
}

enum Role {
  STUDENT
  ADMIN
}

enum TestType {
  CHAPTER
  MODULE
  FULL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

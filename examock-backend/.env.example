# EXAMOCK BACKEND — environment template
# Copy to `.env` locally or set these variables on your hosting platform.
# Never commit real secrets.

# ── Postgres (Supabase) ──────────────────────────────────────────────
# DATABASE_URL → Prisma Client (transaction pooler, port 6543, ?pgbouncer=true)
# DIRECT_URL   → session-mode connection (port 5432) for prisma migrate + pg-boss
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-<region>.pooler.supabase.com:5432/postgres"

# ── Qdrant (vector DB for RAG) ───────────────────────────────────────
QDRANT_URL="https://<cluster>.aws.cloud.qdrant.io"
QDRANT_API_KEY="<qdrant-api-key>"

# ── Server ───────────────────────────────────────────────────────────
PORT=3000
# "dev" → OTPs logged to console, cookies not secure.
# "production" or "prod" → real SMS + secure cookies (both kept in sync via config.isProduction).
NODE_ENV="production"
# Frontend origin — the deployed HTTPS URL, e.g. https://app.examock.com
CLIENT_URI="https://app.examock.com"

# ── JWT ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="<64-hex-chars>"
JWT_REFRESH_SECRET="<64-hex-chars>"
JWT_ACCESS_SECRET_EXPIRY="10m"
JWT_REFRESH_SECRET_EXPIRY="7d"

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<client-secret>"
GOOGLE_REDIRECT_URI="https://api.examock.com/"

# ── MSG91 (OTP SMS — required in production) ─────────────────────────
MSG91_TEMPLATE_ID="<msg91-template-id>"
MSG91_SENDER_ID="<msg91-sender-id>"
MSG91_AUTH_KEY="<msg91-auth-key>"

# ── AI / RAG ─────────────────────────────────────────────────────────
# Google AI Studio key for embeddings (gemini-embedding-001) + answers (gemini-3.6-flash)
GEMINI_API_KEY="<gemini-api-key>"

# ── Cloudinary (note file storage) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"
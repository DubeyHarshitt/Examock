# EXAMOCK FRONTEND — environment template
# Copy to .env and fill in your values.

# Base URL of the backend API. Includes the /api prefix — the backend mounts
# every router under it (e.g. /api/auth, /api/test) and nginx only proxies /api/*.
VITE_API_URL="http://localhost:3000/api"

# Google OAuth client id (public — safe to ship in the browser bundle).
# NEVER put a client secret in a VITE_* env var; it is exposed to the browser.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Canonical site origin (ticket 24) — used ONLY at build time by
# scripts/gen-sitemap.mjs for the absolute URLs in sitemap.xml and the
# robots.txt Sitemap line. Runtime canonical/og:url tags derive themselves
# from window.location, so this can stay unset in dev (defaults to
# http://localhost:5173). Set it to the real domain on the deploy box.
VITE_SITE_URL="http://localhost:5173"

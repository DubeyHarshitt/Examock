# EXAMOCK FRONTEND — environment template
# Copy to .env and fill in your values.

# Base URL of the backend API. Includes the /api prefix — the backend mounts
# every router under it (e.g. /api/auth, /api/test) and nginx only proxies /api/*.
VITE_API_URL="http://localhost:3000/api"

# Google OAuth client id (public — safe to ship in the browser bundle).
# NEVER put a client secret in a VITE_* env var; it is exposed to the browser.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
